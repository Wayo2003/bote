# Copy to .env and fill in. Never commit .env.

# Claude (the agent's brain): https://console.anthropic.com
ANTHROPIC_API_KEY=

# PayPal sandbox app: https://developer.paypal.com > Apps & Credentials > Sandbox > Create App
# Leave both empty to run in demo mode with simulated PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional
PORT=3500
# Public base URL used in pay links (e.g. your Render URL)
PUBLIC_URL=
